# Clawdmeter daemon config
#
# Copy this file to:
#   macOS / Linux : ~/.config/claude-usage-monitor/config
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work
#
# Give each dir a label to get one PAGE per account instead. The display shows
# the label in its title and you swipe between accounts (needs the WiFi hub and
# the *_wifi firmware, see hub-extras/README.md). Labels are ASCII, max 11 chars.
# config_dirs = ~/.claude:work, ~/.claude-personal:personal

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: AMOLED-2.16 / 1.8)
chime = off
# Wall-clock time for the device. The daemon sends the current time with every
# payload; whether the Usage screen shows it (in place of the "Usage" title) is
# decided ON THE DEVICE — swipe left to Settings → Clock (Off / Auto / 12h / 24h).
#   auto = send the time with this machine's 12h/24h preference (default)
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — the device's Clock setting can force 12h or 24h)
#   12   = send the time flagged 12-hour  (e.g. 6:28 PM)
#   24   = send the time flagged 24-hour  (e.g. 18:28)
#   off  = never send the time; the device cannot show a clock at all
clock = auto

# Send this machine's battery level to the device. The Clawdmeter's header
# battery glyph shows the board's own cell when one is fitted, otherwise the
# host's battery (your MacBook's) — a USB-powered board has nothing of its own
# to show. Desktops without a battery send nothing either way.
#   on  = send it (default)
#   off = never send it
host_battery = on

# Claude Code companion — live session state on the device. Claude Code hooks
# post each event (prompt sent, tool running, permission needed, turn done) to
# the daemon, which forwards a compact state to the device: the status line
# reads what Claude is actually doing (a calm green "Ready" while a session
# waits for you, a dim "Idle" when none is open) and the device glows and
# chimes when Claude needs you. Sessions on this machine are watched by process
# id (the hook sends $PPID), so they live exactly as long as their Claude Code
# window; sessions elsewhere time out (30 min silent while working, 12 h idle).
# The session table is saved in companion-state.json next to this file and
# restored when the daemon restarts.
#
# The machine running this daemon is the BRIDGE (it has the Bluetooth link).
# Claude Code can run on the bridge itself or on any other machine that can
# reach it over the network — a dev box you ssh into, a VM, a container.
#   bridge:         install-mac.sh offers the hooks; or python3 companion/install-hooks.py
#   other machines: run `companion/link` on the bridge and paste the printed
#                   line into the other machine, e.g.
#                     curl -fsSL http://192.168.1.23:47393/install/<token> | sh
#                     irm  http://192.168.1.23:47393/install.ps1/<token> | iex   (Windows PowerShell)
#                   That installer comes from the daemon itself with the address
#                   and token baked in (needs curl + python3 or node; PowerShell
#                   needs nothing). `... | sh -s -- --uninstall` removes it.
#   on  = listen for hook events (default)
#   off = no listener, no companion data
companion = on
# Port and interfaces. Bound to every interface by default so other machines
# can join; anything not coming from the bridge itself must present the token.
# Set companion_bind = 127.0.0.1 to accept only this machine (then other
# machines need an SSH tunnel: RemoteForward 47393 127.0.0.1:47393).
companion_port = 47393
companion_bind = 0.0.0.0
# The token remote hooks present. Generated on first start and kept next to
# this file in companion.token; set it here to choose your own.
# companion_token = my-secret

# Stats page — lifetime Claude Code numbers (sessions, messages, tokens, active
# days, streaks, peak hour, favourite model, activity heatmap) computed from the
# transcripts in ~/.claude/projects. Scanned incrementally every 5 minutes; the
# per-file progress lives next to this file in stats-scan.json.
#   on  = scan and send (default)
#   off = no Stats data
stats = on

# Token keeper. The daemon reads the OAuth token Claude Code stores (Keychain on
# macOS, .credentials.json elsewhere) and never refreshes it itself — Claude
# Code owns that. The token lives about eight hours, and only a CLI session
# renews it; if you use the Claude desktop app instead of the CLI, it expires
# and the device shows "No data". With the keeper on, the daemon runs one tiny
# print-mode CLI call (`claude -p … --model haiku`) shortly before the stored
# token expires, or right after a poll is rejected, so Claude Code renews it.
# One Haiku call per eight hours; the session stays off the device.
#   on  = keep the token fresh (default)
#   off = never spawn the CLI; renew by using the CLI yourself
token_keeper = on

